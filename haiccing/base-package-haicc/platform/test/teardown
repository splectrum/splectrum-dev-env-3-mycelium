#!/bin/sh
# The platform's default teardown for a test: its run removed
# ($HAICC_RUN, swarms/test/<test>/), everything it made inside it with it;
# and what it made in Docker for an install inside its run (containers and
# networks labelled haicc.install=<a folder in the run>), whether the test
# passed or not. What it printed stays in the log.
[ -n "${HAICC_RUN:-}" ] && [ -d "$HAICC_RUN" ] || exit 0
if command -v docker >/dev/null 2>&1; then
  for kind in container network; do
    all=; [ $kind = container ] && all=-a
    docker $kind ls $all --filter label=haicc.install --format '{{.ID}} {{.Label "haicc.install"}}' 2>/dev/null | while read -r id at; do
      case "$at" in "$HAICC_RUN"/*) docker $kind rm -f "$id" >/dev/null 2>&1 || docker $kind rm "$id" >/dev/null 2>&1 ;; esac
    done
  done
fi
rm -rf "$HAICC_RUN"
