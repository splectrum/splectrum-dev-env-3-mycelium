#!/bin/sh
# The platform test's cold boot: a fresh install of the package under test
# ($HAICC_PACKAGE), inside this run ($HAICC_RUN), worked through its levels
# with its own ./haicc. Stops at the first step that fails (exit 1), saying which.
set -u
pkg=$HAICC_PACKAGE; run=$HAICC_RUN
# Bare's runtime for its setup: the one this install runs on.
runtime=$HAICC_WORK/bare/bare
# The install is its own: its launchers set its HAICC_WORK; it logs itself.
unset HAICC_WORK HAICC_NOLOG HAICC_SWARM HAICC_AS
w=$run/install
n=0
# A step: what it is, the command it runs (the install's path shortened to
# install/, this run's to run/), then ok, or FAILED with the end of its output.
short () { printf '%s ' "$@" | sed "s#$w#install#g; s#$run#run#g; s#$pkg#package#g; s#$runtime#this-runtime#g; s# \$##"; }
step () { n=$((n + 1)); what=$1; shift; printf '%2d %s\n     $ %s ... ' "$n" "$what" "$(short "$@")"; if out_=$("$@" 2>&1); then echo ok; else echo FAILED; echo "$out_" | tail -30 | sed 's/^/     /'; exit 1; fi; }
expect () { printf '%s' "$out_" | grep -q "$1" || { echo "   expected: $1"; echo "$out_" | tail -20 | sed 's/^/     /'; exit 1; }; }

step 'its setup, built from the package under test and this runtime' sh "$pkg/modules/pear-full-square/haicc-base-boot/release.sh" "$pkg" "$run/haicc-setup.sh" "$runtime"
step 'set up: a fresh install, sourced from this haiccing/' sh "$run/haicc-setup.sh" "$w" "--sources=folder:$(dirname "$pkg")"
step './boot (cold, then warm: the pair refreshed from the sources, deployed)' "$w/boot" --yes
expect 'Booted'
expect "The platform's pair, refreshed from the sources"
expect 'ok     base-package-pkgm: deployed: intact'
expect 'ok     base-package-haicc: deployed: intact'
step 'the sources listed, a manifest kept' "$w/haicc" sources
expect 'base-package-haicc'
expect 'base-package-pkgm'
step 'the install: Bare in bare/, the pair in packages/, ./haicc, the manifest' sh -c "[ -x '$w/bare/bare' ] && [ -x '$w/haicc' ] && [ -f '$w/packages/base-package-haicc/modules/pear-full-square/haicc-base-boot/haicc.js' ] && [ -f '$w/packages/base-package-pkgm/modules/pear-full-square/pkgm-base-manager/index.js' ] && [ -f '$w/haiccing/sources.json' ]"
from=$(dirname "$run")
step "a swarm from a package (this test's own: swarms/hosts; mixed): ./haicc boot platform --from=..." "$w/haicc" boot platform "--from=$from"
expect 'no hash recorded: mixed'
expect 'The swarm hosts: made from platform/swarms/hosts'
expect 'base-package-haicc: intact ('
expect 'The node hosts/master: up'
expect 'The node hosts/node-1: up'
step '  its config copied in, its entry in swarms.json (where from)' sh -c "[ -f '$w/hosts/nodes.json' ] && grep -q '\"package\": \"platform\"' '$w/swarms.json'"
step '  again: booted from its own copy' "$w/haicc" boot platform "--from=$from" --no-echo
expect 'booted from its own copy'
step '  a node added by hand (the swarm not strict), then torn down' sh -c "'$w/hosts/haicc' boot node-9 --no-echo && grep -q node-9 '$w/hosts/nodes.json' && '$w/hosts/haicc' teardown node-9 --yes && ! grep -q node-9 '$w/hosts/nodes.json'"
expect 'node-9 added to nodes.json'
step "the master's cold boot: the platform's pair, and nothing else" sh -c "[ \"\$(ls '$w/hosts/master/packages' | tr '\\n' ' ')\" = 'base-package-haicc base-package-pkgm ' ]"
step 'the node tests a package' "$w/hosts/master/haicc" test base-package-haicc
expect 'test base-package-haicc: passed'
f=packages/base-package-haicc/modules/pear-full-square/haicc-reconcile/index.js
step "a file replaced in node-1's copy (a new file: its original, hard-linked, untouched)" sh -c "rm '$w/hosts/node-1/$f' && echo '// changed' > '$w/hosts/node-1/$f' && cmp -s '$w/hosts/master/$f' '$w/haiccing/base-package-haicc/${f#packages/base-package-haicc/}'"
step "  node-1's warm boot: not intact, said, not up" sh -c "! '$w/hosts/node-1/haicc' boot"
expect 'FAILED base-package-haicc: changed since it was written'
expect 'Not ready'
step "  repaired by the swarm's boot: the pair copied in afresh, intact, up" "$w/hosts/haicc" boot node-1
expect 'base-package-haicc: intact ('
expect 'The node hosts/node-1: up'
step 'the node level: shutdown, boot' sh -c "'$w/hosts/node-1/haicc' shutdown && '$w/hosts/node-1/haicc' boot"
step 'the swarm level: shutdown' "$w/hosts/haicc" shutdown --yes
step '  its nodes gone, nodes.json kept' sh -c "[ ! -e '$w/hosts/master' ] && [ -f '$w/hosts/nodes.json' ]"
step '  boot: rebuilt from nodes.json, the master first' "$w/hosts/haicc" boot --no-echo
step '  both up again' sh -c "[ -x '$w/hosts/master/haicc' ] && [ -x '$w/hosts/node-1/haicc' ]"
step 'the root level: shutdown, boot' sh -c "'$w/haicc' shutdown --yes && '$w/haicc' boot --no-echo"
step 'teardown: the swarm and its entry' "$w/haicc" teardown hosts --yes
step 'the cold shutdown: ./shutdown' "$w/shutdown" --yes
step '  kept: haiccing/, log/, bare/; gone: packages/, ./haicc' sh -c "[ -d '$w/haiccing' ] && [ -d '$w/log' ] && [ -x '$w/bare/bare' ] && [ ! -e '$w/packages' ] && [ ! -e '$w/haicc' ]"
step './boot again: set up from haiccing/' "$w/boot" --yes
expect 'Booted'
echo "the platform: all $n steps passed"
