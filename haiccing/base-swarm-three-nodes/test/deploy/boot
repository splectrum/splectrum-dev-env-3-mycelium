#!/bin/sh
# The package deployed through a root: a fresh install inside this run (the
# platform this one runs, its setup built here; sourced from this
# haiccing/), then this package's swarm made from its configuration, its
# codebase assembled into the swarm's repository, its nodes booted. Stops at
# the first step that fails (exit 1), saying which.
set -u
pkg=$HAICC_PACKAGE; run=$HAICC_RUN; platform=$HAICC_PLATFORM
runtime=$HAICC_WORK/bare/bare; sources=$HAICC_WORK/haiccing
unset HAICC_WORK HAICC_NOLOG HAICC_SWARM HAICC_AS
w=$run/install
n=0
short () { printf '%s ' "$@" | sed "s#$w#install#g; s#$run#run#g; s#$pkg#package#g; s#$(dirname "$pkg")#packages#g; s#$platform#platform#g; s#$runtime#this-runtime#g; s# \$##"; }
step () { n=$((n + 1)); what=$1; shift; printf '%2d %s\n     $ %s ... ' "$n" "$what" "$(short "$@")"; if out_=$("$@" 2>&1); then echo ok; else echo FAILED; echo "$out_" | tail -30 | sed 's/^/     /'; exit 1; fi; }
expect () { printf '%s' "$out_" | grep -q "$1" || { echo "   expected: $1"; echo "$out_" | tail -20 | sed 's/^/     /'; exit 1; }; }

step 'a setup of the platform this runs on' sh "$platform/modules/pear-full-square/haicc-base-boot/release.sh" "$platform" "$run/haicc-setup.sh" "$runtime"
step 'a fresh install, sourced from this haiccing/' sh "$run/haicc-setup.sh" "$w" "--sources=folder:$sources"
step './boot' "$w/boot" --yes
expect 'Booted'
step 'the package deployed: ./haicc boot <package> (its swarms)' "$w/haicc" boot "$(basename "$pkg")" "--from=$(dirname "$pkg")"
expect ': intact ('
expect 'The swarm three-nodes: made from'
expect '(sealed)'
expect 'assembled into three-nodes/master/packages/base-swarm-three-nodes/'
expect 'The node three-nodes/master: up'
expect 'The node three-nodes/node-1: up'
expect 'The node three-nodes/node-2: up'
step "  its config copied in; the master's packages/: the codebase, what it was made from" sh -c "[ -f '$w/three-nodes/nodes.json' ] && [ -f '$w/three-nodes/modules.json' ] && [ -f '$w/three-nodes/master/packages/base-swarm-three-nodes/modules/pear-full-square/p2p-node/package.json' ] && grep -q '\"swarm\": \"three-nodes\"' '$w/three-nodes/master/packages/base-swarm-three-nodes/contents.json' && [ ! -e '$w/three-nodes/node-1/packages/base-swarm-three-nodes' ]"
step '  its nodes running: three containers, the nodes registered with the master' sh -c "[ \$(docker ps -q --filter 'label=haicc.install=$w' --filter label=haicc.swarm=three-nodes | wc -l) = 3 ] && docker logs \$(sed -n 's/.*\"container\": \"\\(.*\\)\".*/\\1/p' '$w/three-nodes/master/node.json') 2>&1 | grep -q '\"uri\":\"/three-nodes/node-2\"'"
step "  a node's shutdown and boot: its container stopped, started again, its key kept" sh -c "k=\$(grep -o '\"key\": \"[0-9a-f]*' '$w/three-nodes/node-1/node.json' | head -1) && '$w/three-nodes/node-1/haicc' shutdown && [ \$(docker ps -q --filter 'label=haicc.install=$w' | wc -l) = 2 ] && '$w/three-nodes/node-1/haicc' boot && grep -q \"\$k\" '$w/three-nodes/node-1/node.json'"
expect 'the node running: /three-nodes/node-1'
step '  again: booted from its own copy' "$w/haicc" boot "$(basename "$pkg")" "--from=$(dirname "$pkg")" --no-echo
expect 'booted from its own copy'
step '  by its name: ./haicc boot three-nodes' "$w/haicc" boot three-nodes --no-echo
step '  under another name too, strict: --as=other --strict' "$w/haicc" boot "$(basename "$pkg")/three-nodes" "--from=$(dirname "$pkg")" --as=other --strict --no-echo
step '    strict: a node not in its package refused' sh -c "! '$w/other/haicc' boot node-9"
expect 'the swarm other is strict'
step '  the swarm shut down and booted: its containers and network gone, then the codebase assembled again' sh -c "'$w/three-nodes/haicc' shutdown --yes && [ ! -e '$w/three-nodes/master' ] && [ \$(docker ps -aq --filter 'label=haicc.install=$w' --filter label=haicc.swarm=three-nodes | wc -l) = 0 ] && ! docker network ls --filter 'label=haicc.install=$w' --filter label=haicc.swarm=three-nodes -q | grep -q . && '$w/three-nodes/haicc' boot --no-echo && [ -f '$w/three-nodes/master/packages/base-swarm-three-nodes/contents.json' ]"
step 'teardown: both swarms, nothing of them left in Docker' sh -c "'$w/haicc' teardown three-nodes --yes && '$w/haicc' teardown other --yes && [ ! -e '$w/three-nodes' ] && [ ! -e '$w/other' ] && [ -z \"\$(docker ps -aq --filter 'label=haicc.install=$w')\" ] && [ -z \"\$(docker network ls -q --filter 'label=haicc.install=$w')\" ]"
echo "the deployment: all $n steps passed"
