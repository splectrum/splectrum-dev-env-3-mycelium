node_modules/

# A HAICC command run in a source folder logs there (HAICC_WORK defaults to .): never kept.
pear-full-square/*/log/

# The local source, by organisation: haiccing/ (the packages as Bare bundles,
# their manifest), holepunchto/ (the pinned Bare's tarball), addons/ (by hash,
# shared): --sources=folder:sources. Built here, never kept.
/sources/
